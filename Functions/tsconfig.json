{
	"compilerOptions": {
		"outDir": "dist", // https://www.typescriptlang.org/tsconfig/#outDir
		"rootDir": "./src", // https://www.typescriptlang.org/tsconfig/#rootDir
		"target": "ESNext", // https://www.typescriptlang.org/tsconfig/#target
		"module": "NodeNext", // https://www.typescriptlang.org/tsconfig/#module
		"moduleResolution": "NodeNext", // https://www.typescriptlang.org/tsconfig/#moduleResolution
		"skipLibCheck": true, // https://www.typescriptlang.org/tsconfig/#skipLibCheck
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		// Email templates are React components (src/email/templates).
		"jsx": "react-jsx"
	},
	// Only src is compiled, and tests are excluded from the emitted output so
	// they are never deployed. tsconfig.test.json type-checks them separately.
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "node_modules", "dist"]
}
