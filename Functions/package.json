{
	"name": "@minneapolis-winter-league/functions",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"engines": {
		"node": "22"
	},
	"scripts": {
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"dependencies": {
		"bad-words": "^4.0.0",
		"firebase-admin": "^14.4.0",
		"firebase-functions": "^7.2.5",
		"stripe": "^22.0.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"prettier": "^3.8.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.1",
		"vitest": "^5.0.1"
	}
}
