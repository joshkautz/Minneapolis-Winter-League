{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run build:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run format:*)",
			"Bash(npm run test:*)",
			"Bash(npm run typecheck:*)",
			"Bash(npm run emulators:*)",
			"Bash(npm run seed:*)",
			"Bash(npm ci)",
			"Bash(npm install)",
			"Bash(npm ls:*)",
			"Bash(npm outdated:*)",
			"Bash(npm audit:*)",
			"Bash(npm view:*)",
			"Bash(npx tsc --noEmit:*)",
			"Bash(npx eslint:*)",
			"Bash(npx prettier:*)",
			"Bash(npx vitest run:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git ls-files:*)",
			"Bash(git rev-parse:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh run view:*)",
			"Bash(gh run list:*)",
			"Bash(firebase --version)",
			"Bash(firebase emulators:exec:*)",
			"Bash(firebase functions:list:*)",
			"WebFetch(domain:firebase.google.com)",
			"WebFetch(domain:docs.stripe.com)",
			"WebFetch(domain:developers.hellosign.com)",
			"WebFetch(domain:ui.shadcn.com)",
			"WebFetch(domain:react.dev)",
			"WebFetch(domain:vite.dev)",
			"WebFetch(domain:tailwindcss.com)"
		],
		"deny": [
			"Read(./App/.env.production)",
			"Read(./App/.env.staging)",
			"Read(./.secret.local)",
			"Read(./Functions/.secret.local)",
			"Read(./scripts/production/data/**)",
			"Read(./.emulator/**)"
		],
		"ask": [
			"Bash(firebase deploy:*)",
			"Bash(firebase firestore:delete:*)",
			"Bash(firebase functions:delete:*)",
			"Bash(firebase functions:secrets:*)",
			"Bash(npm run deploy:*)",
			"Bash(npm run data:refresh:*)",
			"Bash(node scripts/production/**)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-file.sh\"",
						"timeout": 60,
						"statusMessage": "Formatting edited file"
					}
				]
			}
		]
	}
}
