rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    //////////////////////////////////////////////////////////////////////////////
    // STRIPE INTEGRATION - Secure payment data access
    //////////////////////////////////////////////////////////////////////////////

    // STRIPE: Custom Stripe integration for payments
    match /stripe/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // Checkout sessions: Read-only (created by createStripeCheckout function)
      // No frontend write access needed - all checkout creation goes through callable function
      match /checkouts/{id} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false; // Functions only
      }

      // Payments: Read-only for users (created by Stripe webhook)
      match /payments/{id} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false; // Webhook only
      }
    }

    //////////////////////////////////////////////////////////////////////////////
    // DROPBOX SIGN - historical waiver records (before September 2026)
    //////////////////////////////////////////////////////////////////////////////

    // Kept as history and written by nothing. Current waiver signatures are
    // players/{playerId}/waiverSignatures, below.
    match /dropbox/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      match /waivers/{id} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if false; // Use createSeason
      allow update: if false; // Use updateSeason
      allow delete: if false; // Use deleteSeason
    }
    
    match /games/{gameId} {
      allow read: if true;
      allow create: if false; // Use createGame
      allow update: if false; // Use updateGame
      allow delete: if false; // Use deleteGame
    }
    
    match /teams/{teamId} {
      allow read: if true;
      allow create: if false; // Use createTeam
      allow update: if false; // Use updateTeam, updateTeamRoster
      allow delete: if false; // Use deleteTeam

      // Per-season participation subdocuments
      match /teamSeasons/{seasonId} {
        allow read: if true;
        allow write: if false; // Functions only

        // Pure membership join, one doc per (team, season, player)
        match /roster/{playerId} {
          allow read: if true;
          allow write: if false; // Functions only
        }

        // Team payments: who paid what toward the registration total.
        // Private to the team — its roster for this season, and admins —
        // which is also why no totals are kept on the public team-season
        // document above. There is deliberately no collection-group rule,
        // so nobody can list every team's money at once.
        match /contributions/{paymentIntentId} {
          allow read: if isAuthenticated() && (
            exists(/databases/$(database)/documents/teams/$(teamId)/teamSeasons/$(seasonId)/roster/$(request.auth.uid))
            || isAdmin()
          );
          allow write: if false; // Functions only
        }

        // Checkouts teammates have open right now, and what each reserves.
        // Private exactly as the ledger is, and for the same reason.
        match /checkouts/{docId} {
          allow read: if isAuthenticated() && (
            exists(/databases/$(database)/documents/teams/$(teamId)/teamSeasons/$(seasonId)/roster/$(request.auth.uid))
            || isAdmin()
          );
          allow write: if false; // Functions only
        }
      }
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if false; // Use createPlayer
      allow update: if false; // Use updatePlayer
      allow delete: if false; // Use deletePlayer

      // Per-season participation subdocuments (paid, signed, captain, team).
      // A ban is account-wide, so it is `banned` on the player document.
      match /playerSeasons/{seasonId} {
        allow read: if true;
        allow write: if false; // Functions only
      }

      // Waiver signatures: date of birth, mailing address and emergency
      // contacts, so private to that player and admins — unlike the player
      // document above, which anyone can read. Written only by signWaiver and
      // updatePlayerAdmin, and never changed afterwards.
      match /waiverSignatures/{signatureId} {
        allow read: if isAuthenticated()
          && (request.auth.uid == playerId || isAdmin());
        allow write: if false; // Functions only
      }
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow create: if false; // Use createOffer
      allow update: if false; // Use updateOffer
      allow delete: if false; // Manual process
    }

    match /news/{newsId} {
      allow read: if true; // Public read access for all users
      allow create: if false; // Use createNews
      allow update: if false; // Use updateNews
      allow delete: if false; // Use deleteNews
    }

    match /rankings/{playerId} {
      allow read: if true;
      allow create: if false; // Functions only
      allow update: if false; // Functions only
      allow delete: if false; // Functions only
    }
    
    match /rankings-history/{snapshotId} {
      allow read: if true;
      allow create: if false; // Functions only
      allow update: if false; // Functions only
      allow delete: if false; // Functions only
    }
    
    match /rankings-calculations/{calculationId} {
      allow read: if true;
      allow create: if false; // Functions only
      allow update: if false; // Functions only
      allow delete: if false; // Functions only
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow create: if false; // Use createBadge
      allow update: if false; // Use updateBadge
      allow delete: if false; // Use deleteBadge
    }

    match /teams/{teamId}/badges/{badgeId} {
      allow read: if true;
      allow create: if false; // Use awardBadge
      allow update: if false; // Badges are immutable once awarded
      allow delete: if false; // Use revokeBadge
    }

    // Collection-group access. Firestore rules require an explicit recursive
    // match for `collectionGroup()` queries even when the direct subcollection
    // path is already allowed above. These mirror the read posture of the
    // direct-path rules; writes stay locked behind Functions.
    match /{path=**}/teamSeasons/{seasonId} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    match /{path=**}/playerSeasons/{seasonId} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    match /{path=**}/badges/{badgeId} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    match /siteSettings/{settingId} {
      allow read: if true; // Public read for theme settings
      allow create: if false; // Use updateSiteSettings
      allow update: if false; // Use updateSiteSettings
      allow delete: if false; // Manual process only
    }

    match /posts/{postId} {
      allow read: if true; // Public read access
      allow create: if false; // Use createPost
      allow update: if false; // Use updatePost
      allow delete: if false; // Use deletePost (admin only)

      match /replies/{replyId} {
        allow read: if true; // Public read access
        allow create: if false; // Use createReply
        allow update: if false; // Use updateReply
        allow delete: if false; // Use deleteReply (admin only)
      }
    }

    // Admin status is sourced from the player document's `admin` boolean
    // field (this codebase doesn't use Firebase Auth custom token claims),
    // so we read the player doc to check it.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.admin == true;
    }

    // Maintenance / migration kill-switch flag. Setting it stops every
    // trigger, so no client may write it, admins included:
    // scripts/production/set-maintenance.js flips it with the Admin SDK,
    // which bypasses these rules.
    match /system/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}