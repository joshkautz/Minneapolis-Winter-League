{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,

		"outDir": "dist",
		// The repository root rather than App/, because the waiver's text and
		// signing rules are imported from Functions/src/waiver/ so the two
		// workspaces cannot word the waiver differently (see
		// src/shared/waiver.ts). Nothing is emitted (noEmit), so this only
		// widens what type-checking may include.
		"rootDir": "..",

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting - Enhanced strict mode (some settings temporarily relaxed) */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"useUnknownInCatchVariables": true,
		// "exactOptionalPropertyTypes": true, // Temporarily disabled - enable gradually
		// "noUncheckedIndexedAccess": true,   // Temporarily disabled - enable gradually

		// TypeScript 7 removed `baseUrl`. Every mapping below is already
		// written relative to this file ("./src/..."), which is how `paths`
		// resolves without it, so the aliases are unchanged.
		"paths": {
			"@/*": ["./src/*"],
			"@/features/*": ["./src/features/*"],
			"@/shared/*": ["./src/shared/*"],
			"@/providers/*": ["./src/providers/*"],
			"@/routes/*": ["./src/routes/*"],
			"@/firebase/*": ["./src/firebase/*"],
			"@/components/*": ["./src/components/*"]
		}
	},
	"include": ["src/**/*"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
