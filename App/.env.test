# Test-mode Firebase configuration.
#
# Vitest runs Vite in `test` mode, which loads this file instead of
# .env.development. The values are deliberately fake: App/src/firebase/app.ts
# throws at import time if any of them is missing, and every test that mounts a
# component tree transitively imports it. Emulator mode is on so the SDK points
# every call at localhost — a test run never opens an outbound connection, even
# when no emulator is listening.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-test
VITE_FIREBASE_STORAGE_BUCKET=demo-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=true
VITE_LOG_LEVEL=silent
